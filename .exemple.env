# Copiez ce fichier en « .env » puis remplissez les valeurs. Ne publiez jamais le fichier .env.

# --- Serveur ---
# Une longue phrase aléatoire, par exemple : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
BASE_URL=http://localhost:3000
PORT=3000
# development en local, production chez l'hébergeur (cookies sécurisés, https)
NODE_ENV=development

# --- Base MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=para_noel
# true pour une base en ligne qui exige une connexion chiffrée (TiDB Cloud, Aiven…). Laisser vide avec MAMP.
DB_SSL=

# --- E-mails avec Brevo (vérification d'inscription, reçus, messages de contact) ---
# Clé API : brevo.com → menu de votre compte → SMTP & API → Clés API → « Générer une nouvelle clé »
BREVO_API_KEY=
# Adresse d'expédition : doit être validée dans Brevo (Expéditeurs, domaines et IP dédiées)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Para'Noel"

# --- Solution de secours si BREVO_API_KEY est vide : serveur SMTP (ex. Mailtrap en local) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Para'Noel <no-reply@paranoel.bj>"
# Adresse qui reçoit les messages de contact et les candidatures
CONTACT_EMAIL=

# --- Paiement Mobile Money (MTN, Moov, Celtiis) avec KKiaPay ---
# simulation : aucun argent réel, pour développer et tester (refusé en production)
# kkiapay     : vrais paiements via KKiaPay (clés dans le tableau de bord KKiaPay → Développeurs → Clés API)
PAIEMENT_MODE=simulation
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
# true = clés de test (sandbox), false = vrais paiements
KKIAPAY_SANDBOX=true
# Secret choisi en créant le webhook dans KKiaPay (adresse : <BASE_URL>/api/paiements/kkiapay/webhook)
KKIAPAY_WEBHOOK_SECRET=

# --- Limites anti-abus (facultatif) : tentatives par quart d'heure et par adresse IP ---
AUTH_RATE_LIMIT=7
FORM_RATE_LIMIT=5
PAIEMENT_RATE_LIMIT=20

# --- Connexion avec Google (facultatif : bouton inactif si vide) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Fichiers envoyés (galerie, illustrations, questionnaires PDF, photos des réponses) ---
# Vide : fichiers sur le disque (MAMP, en local). Rempli : Cloudflare R2 (obligatoire en ligne sur Render).
# Cloudflare → R2 Object Storage → Manage API tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=paranoel
